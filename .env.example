# Database (Supabase PostgreSQL - Transaction Pooler & Direct)
DATABASE_URL="postgresql://[USER].[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://[USER].[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Application
NEXT_PUBLIC_APP_NAME="SembakoDistro"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
